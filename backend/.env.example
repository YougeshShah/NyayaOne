# ==============================
# NyayaOne Backend Environment Variables
# Copy this file to .env and fill values before running the app
# ==============================

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://nyayaone:nyayaone_dev_password@localhost:5432/nyayaone_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET=replace_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_with_a_long_random_string_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Storage (local for now, switch to cloud later without code changes)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
