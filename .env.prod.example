# Copy this to .env.prod and fill in real values. Never commit .env.prod.

# --- Database ---
DB_USER=nyayaone
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
DB_NAME=nyayaone_db

# --- Backend ---
NODE_ENV=production
PORT=5000
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_LONG_STRING
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_LONG_STRING
CORS_ORIGIN=https://admin.yourdomain.com,https://firm.yourdomain.com,https://learn.yourdomain.com

# --- AI features (leave blank to keep Chatbot/Content Generator disabled — $0 cost) ---
ANTHROPIC_API_KEY=

# --- Payment gateways (fill in once merchant accounts are approved) ---
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
